# Copy to .env for local development (git-ignored). Dev-only values matching infra/.
PUBLIC_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8080
VALKEY_URL=redis://localhost:6379
# Signs the session cookie. Any long random string in dev; a secret in production.
SESSION_SECRET=dev-only-session-secret-change-me
# Used from build-order step 2 (login through Keycloak).
OIDC_ISSUER=http://localhost:8180/realms/partecipa
OIDC_CLIENT_ID=partecipa-web
OIDC_CLIENT_SECRET=dev-partecipa-web-secret
